# Supabase — get these from your Supabase project dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Admin dashboard — choose a strong password
ADMIN_PASSWORD=

# Resend — transactional email (newsletter + employer status alerts)
RESEND_API_KEY=
NEWSLETTER_FROM=
ALERT_FROM=

# Secret for HMAC unsubscribe tokens (falls back to ADMIN_PASSWORD if unset)
UNSUBSCRIBE_SECRET=

# Vercel Cron auth — required by /api/cron/notify (daily employer status-change check)
CRON_SECRET=
